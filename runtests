#!/usr/bin/env python
"""Run the CI suite or selected Django test labels."""

import os
import re
import sys
from importlib import import_module
from unittest import TestCase


def main():
    default = len(sys.argv) == 1
    pattern = re.compile(
        r"(?P<module>flat_json_widget\.tests|test_app\.tests)"
        r"(?:\.(?P<class>[A-Z]\w*)(?:\.test_\w+)?)?"
    )
    labels = []
    flags = []
    for argument in sys.argv[1:]:
        if argument in ("--failfast", "--noinput"):
            flags.append(argument)
            continue
        match = pattern.fullmatch(argument)
        if not match:
            print(f"Unsupported test argument: {argument}", file=sys.stderr)
            return 2
        labels.append(match)
    if not labels and not default:
        print("Unsupported test arguments: a test label is required", file=sys.stderr)
        return 2
    sys.path.insert(0, "tests")
    sys.argv.insert(1, "test")
    os.environ["DJANGO_SETTINGS_MODULE"] = "settings"
    import django

    django.setup()
    for match in labels:
        if match.group("class"):
            module = import_module(match.group("module"))
            candidate = getattr(module, match.group("class"), None)
            if not isinstance(candidate, type) or not issubclass(candidate, TestCase):
                print(f"Unsupported test argument: {match.group(0)}", file=sys.stderr)
                return 2
    from django.core.management import execute_from_command_line

    selected = (
        [match.group(0) for match in labels]
        if labels
        else ["flat_json_widget", "tests"]
    )
    execute_from_command_line([sys.argv[0], "test", *selected, *flags])
    return 0


if __name__ == "__main__":
    sys.exit(main())
